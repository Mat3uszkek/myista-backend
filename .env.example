NGENIUS_OUTLET=
NGENIUS_WEBHOOK_USERNAME=
NGENIUS_WEBHOOK_PASSWORD=

# APS / Amazon Payment Services (formerly PayFort — configurable variant — assign in PaymentGatewayRegistry)
APS_MERCHANT_IDENTIFIER=
APS_ACCESS_CODE=
APS_SHA_REQUEST_PHRASE=
APS_HPP_URL=https://checkout.payfort.com/FortAPI/paymentPage

# WorldPay (configurable variant — assign in PaymentGatewayRegistry)
WORLDPAY_URL=https://secure.worldpay.com/jsp/merchant/xml/paymentService.jsp
WORLDPAY_MERCHANT_CODE=
WORLDPAY_XML_PASSWORD=
WORLDPAY_JS_LIB_URL=https://secure.worldpay.com/wcc/wrappedMessages

# Commercial Bank Qatar (Qatar QuickPay guest checkout)
CBQ_URL=https://cbq.gateway.mastercard.com/api/rest/version/61
CBQ_MERCHANT_ID=
CBQ_PASSWORD=
CBQ_JS_LIB_URL=https://cbq.gateway.mastercard.com/static/checkout/checkout.min.js
CBQ_NOTIFICATION_URL=https://your-domain/quickpay/status/cbq/success

